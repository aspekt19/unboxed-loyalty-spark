{
  "name": "Loyal Spark",
  "description": "Onchain loyalty protocol on Base L2. Two API personas with x-api-key: merchant (lsk_, agent-api 28 authenticated routes + 1 public + loyalty-mcp 39 tools) and recipient (rwk_, recipient-api 14 routes + recipient-loyalty-mcp 20 tools). Pay-per-request via MPP (pathUSD/USDC on Tempo) or x402 v2 (USDC on Base). Includes autonomous workflow planners (workflow/*) for self-orchestrating agents.",
  "url": "https://loyalspark.online",
  "version": "2.3.0",
  "payment_methods": [
    {
      "method": "base:usdc",
      "network": "base",
      "chain_id": 8453,
      "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
      "recipient": "0x40a8CdD6a10EC1a8cB3dFb2834675e7a2CF4ad8b",
      "decimals": 6
    },
    {
      "method": "tempo:pathusd",
      "currency": "0x20c0000000000000000000000000000000000000",
      "recipient": "0x40a8CdD6a10EC1a8cB3dFb2834675e7a2CF4ad8b"
    },
    {
      "method": "tempo:usdc",
      "currency": "0x20C000000000000000000000b9537d11c60E8b50",
      "recipient": "0x40a8CdD6a10EC1a8cB3dFb2834675e7a2CF4ad8b"
    }
  ],
  "gateway": {
    "mpp": "https://api.loyalspark.online/mpp-gateway",
    "x402": "https://api.loyalspark.online/x402-gateway"
  },
  "openapi": "https://loyalspark.online/openapi.json",
  "authentication": {
    "type": "api_key",
    "header": "x-api-key",
    "prefixes": {
      "lsk_": "Merchant agent — agent-api/* and loyalty-mcp",
      "rwk_": "Recipient agent (wallet holder) — recipient-api/* and recipient-loyalty-mcp"
    },
    "registration_url": "https://loyalspark.online/merchant",
    "siwe_url": "https://api.loyalspark.online/agent-register-siwe"
  },
  "pricing": {
    "model": "pay-per-request",
    "currency": "USD",
    "endpoints": {
      "GET /me": { "price": "0", "description": "Agent profile (free)" },
      "GET /programs": { "price": "0.001", "description": "List loyalty programs" },
      "GET /rewards": { "price": "0.001", "description": "List rewards" },
      "GET /balance": { "price": "0.001", "description": "Check token balance" },
      "GET /customers": { "price": "0.002", "description": "List customers" },
      "GET /vouchers": { "price": "0.001", "description": "List vouchers" },
      "GET /analytics": { "price": "0.005", "description": "Program analytics" },
      "GET /offers": { "price": "0.001", "description": "List marketplace offers" },
      "GET /merchant-profile": { "price": "0.001", "description": "Read merchant profile (display name, category, etc.)" },
      "POST /programs": { "price": "0.05", "description": "Deploy new loyalty token" },
      "POST /register-program": { "price": "0.01", "description": "Register deployed token" },
      "POST /update-program-config": { "price": "0.005", "description": "Update cashback / points per dollar" },
      "POST /activate-program": { "price": "0.01", "description": "Get activation calldata" },
      "POST /program-status": { "price": "0.005", "description": "Update program status" },
      "POST /rewards": { "price": "0.01", "description": "Create reward" },
      "POST /mint": { "price": "0.01", "description": "Mint tokens. Returns a fee-first calls[] bundle; the plan mint fee % is charged separately in the merchant's own loyalty tokens (not USDC) and must be settled via POST /mint/confirm" },
      "POST /mint/confirm": { "price": "0", "description": "Settle a mint fee obligation (obligation_id + fee_tx_hash)" },
      "POST /earn": { "price": "0.01", "description": "Auto-mint cashback from purchase amount. Same fee-first bundle and /mint/confirm rules as POST /mint" },
      "POST /transfer": { "price": "0.005", "description": "Transfer tokens" },
      "POST /redeem-reward": { "price": "0.01", "description": "Redeem reward (verify tx + create voucher)" },
      "POST /vouchers/use": { "price": "0.005", "description": "Mark voucher as used" },
      "POST /offers": { "price": "0.01", "description": "Create marketplace offer" },
      "POST /accept-offer": { "price": "0.01", "description": "Accept offer" },
      "POST /cancel-offer": { "price": "0.005", "description": "Cancel offer" },
      "POST /merchant-profile": { "price": "0.005", "description": "Create merchant profile" },
      "PUT /merchant-profile": { "price": "0.005", "description": "Update merchant profile" },
      "GET /vouchers/status": { "price": "0", "description": "Public voucher status check (no key)" },
      "GET /tx-receipt": { "price": "0", "description": "Extract token_address from deploy tx" },
      "GET /workflow/program-status": { "price": "0.001", "description": "Autonomous planner: current merchant lifecycle step + next_actions[]" },
      "POST /workflow/generate-program-defaults": { "price": "0.001", "description": "Autonomous planner: propose program name, symbol, cashback, starter rewards" }
    },
    "recipient_endpoints": {
      "GET recipient-api/me": { "price": "0", "description": "Recipient profile" },
      "GET recipient-api/balances": { "price": "0.001", "description": "All loyalty balances" },
      "GET recipient-api/balance": { "price": "0.001", "description": "One-token balance and tier" },
      "GET recipient-api/rewards": { "price": "0.001", "description": "Rewards available to redeem" },
      "GET recipient-api/vouchers": { "price": "0.001", "description": "Vouchers for this wallet" },
      "GET recipient-api/offers": { "price": "0.001", "description": "P2P marketplace offers" },
      "GET recipient-api/workflow/reward-status": { "price": "0.001", "description": "Autonomous planner: current recipient reward step + next_actions[]" },
      "POST recipient-api/register": { "price": "0", "description": "Wallet registration after SIWE" },
      "POST recipient-api/prepare-transfer": { "price": "0.005", "description": "Loyalty token transfer calldata" },
      "POST recipient-api/redeem-reward": { "price": "0.01", "description": "Redeem reward via tx hash" },
      "POST recipient-api/offers": { "price": "0.01", "description": "Create P2P swap intent" },
      "POST recipient-api/accept-offer": { "price": "0.01", "description": "Accept P2P offer" },
      "POST recipient-api/cancel-offer": { "price": "0.005", "description": "Cancel P2P offer" },
      "POST recipient-api/workflow/prepare-reward-redemption": { "price": "0.005", "description": "Autonomous planner: transfer calldata for reward cost + workflow metadata" }
    },
    "mcp_paid_url_templates": {
      "merchant": "{x402_or_mpp_gateway}/mcp-tools/{tool_name}",
      "recipient": "{x402_or_mpp_gateway}/recipient-mcp-tools/{tool_name}",
      "default_price_usd": "0.01",
      "schemas": {
        "merchant": "supabase/functions/_shared/mcp-bazaar-tools.ts",
        "recipient": "supabase/functions/_shared/recipient-mcp-bazaar-tools.ts"
      }
    }
  },
  "docs": "https://loyalspark.online/api-docs",
  "llms_txt": "https://loyalspark.online/llms.txt",
  "contact": {
    "website": "https://loyalspark.online",
    "email": "admin@loyalspark.online",
    "twitter": "https://x.com/Loyal_Spark"
  }
}