          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token_address": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "cost": { "type": "number" }
                },
                "required": ["token_address", "name", "cost"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": { "application/json": { "schema": { "type": "object" } } }
